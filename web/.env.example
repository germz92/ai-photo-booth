# App
# Local: http://localhost:3000
# Render: https://lumetry-ai-booth.onrender.com  (never localhost in production)
APP_URL="http://localhost:3000"
WEBHOOK_SECRET="change-me"
AUTH_SECRET="generate-a-long-random-string"

# MongoDB (replica set required). Local:
#   docker compose up -d
#   DATABASE_URL="mongodb://127.0.0.1:27018/booth?replicaSet=rs0&directConnection=true"
# Atlas:
#   DATABASE_URL="mongodb+srv://USER:PASS@cluster/booth"
DATABASE_URL="mongodb://127.0.0.1:27018/booth?replicaSet=rs0&directConnection=true"
DATA_DIR="./data"

# First admin user is created when the AdminUser collection is empty.
# That email is always kept as superadmin (default: admin@localhost).
ADMIN_BOOTSTRAP_EMAIL="admin@localhost"
ADMIN_BOOTSTRAP_PASSWORD="changeme"
SUPERADMIN_CREDITS="10000"

# Local demo: skip GPU and print delivery instead of sending
MOCK_RUNPOD="true"
MOCK_DELIVERY="true"

# RunPod
RUNPOD_API_KEY=""
RUNPOD_ENDPOINT_ID=""
WORKFLOW_PATH="../workflows/booth-api.json"

# Object storage: local files by default. Use s3 for R2/S3.
# Real AWS: leave S3_ENDPOINT empty. Optional S3_PREFIX keeps booth objects in a folder.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PREFIX=""
S3_PUBLIC_BASE_URL=""

# Email (SendGrid). Leave empty to log the result link instead.
SENDGRID_API_KEY=""
EMAIL_FROM="Lumetry AI Booth <booth@example.com>"

# SMS (Twilio). Leave empty to log the result link instead.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
