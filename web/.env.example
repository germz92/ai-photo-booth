# App
APP_URL="http://localhost:3000"
WEBHOOK_SECRET="change-me"
# Local SQLite. For Postgres: change prisma/schema.prisma provider to postgresql
# and use DATABASE_URL=postgresql://booth:booth@localhost:5432/booth after docker compose up -d.
DATABASE_URL="file:./dev.db"
DATA_DIR="./data"

# Local demo: skip GPU and print delivery instead of sending
MOCK_RUNPOD="true"
MOCK_DELIVERY="true"

# RunPod (set MOCK_RUNPOD=false in production)
RUNPOD_API_KEY=""
RUNPOD_ENDPOINT_ID=""
WORKFLOW_PATH="../workflows/booth-api.json"

# Object storage: local files by default. Use s3 for R2/S3.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PUBLIC_BASE_URL=""

# Email (Resend). Leave empty to log the result link instead.
RESEND_API_KEY=""
EMAIL_FROM="Photo Booth <booth@example.com>"

# SMS (Twilio). Leave empty to log the result link instead.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
