generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id              String    @id @default(cuid())
  status          String    @default("queued")
  email           String?
  phone           String?
  consent         Boolean
  originalKey     String
  outputKey       String?
  runpodJobId     String?   @unique
  resultToken     String    @unique
  resultExpiresAt DateTime
  emailStatus     String    @default("pending")
  smsStatus       String    @default("pending")
  emailAttempts   Int       @default(0)
  smsAttempts     Int       @default(0)
  emailError      String?
  smsError        String?
  error           String?
  kreaSeed        String
  qwenSeed        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}
